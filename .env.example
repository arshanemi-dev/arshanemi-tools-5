# ═══════════════════════════════════════════════════════════════════════════════
# arshanemi-tools-5 — Profit & Loss dashboard
# ═══════════════════════════════════════════════════════════════════════════════

# ── Connected mode ───────────────────────────────────────────────────────────
# "true"  → /api/auth/* and /api/admin/theme proxy to the root admin panel at
#           NEXT_PUBLIC_ADMIN_API_URL; /api/profit-loss/* proxy the caller's own
#           token there for per-user settings + history persistence.
# "false" → local mode: auth reads/writes this app's own Vercel Blob JSON store;
#           the "Save to History" / "My Details" features are unavailable.
NEXT_PUBLIC_IS_CONNECT=true
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3000

# ── Billing ──────────────────────────────────────────────────────────────────
# "true"  → "Save to History" is metered: 1 coin per 100 parsed rows, deducted
#           by the admin panel (POST /api/wallet/deduct, coinCost:1, quantity).
#           Browsing / computing / exporting is always free.
# "false" → nothing is ever charged (save still requires login).
NEXT_PUBLIC_IS_PAID=true

# ── OTP ──────────────────────────────────────────────────────────────────────
# "true" bypasses every OTP step (dev/staging only).
NEXT_PUBLIC_IS_OTP_Verifications_Disable=false

# ── /profile UI flags ────────────────────────────────────────────────────────
NEXT_PUBLIC_IS_Header_Hide=false
NEXT_PUBLIC_SHOW_FLOATING_MENU=false

# Namespaces this app's JSON files inside the shared Blob store (local mode).
TOOLS_NAME=barmeto-profit-loss

# ── Auth (JWT) — MUST match the root admin panel's values in connected mode ──
JWT_SECRET="<your-jwt-secret-min-64-chars>"
JWT_REFRESH_SECRET="<your-jwt-refresh-secret>"
NEXT_PUBLIC_SITE_URL="https://profit-loss.barmeto.com/"

# ── CORS — exact origins that call /api/* directly from the browser ──────────
ALLOWED_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# ── SMTP — Gmail App Password (login/reset OTP email) ───────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="<your-sender-email>"
SMTP_PASS="<your-gmail-app-password>"
COMPANY_EMAIL_TO="<your-support-email>"

# ── MSG91 (mobile OTP) — optional; console-logs the OTP if unset ────────────
MSG91_AUTH_KEY="<your-msg91-authkey>"
MSG91_TEMPLATE_ID="<your-msg91-template-id>"
MSG91_OTP_VAR_NAME="VAR1"
MSG91_DEFAULT_COUNTRY_CODE="91"

# ── Vercel Blob — auth store (local mode) + saved-run raw files ─────────────
BLOB_STORE_ID="<your-blob-store-id>"
BLOB_READ_WRITE_TOKEN="<your-blob-read-write-token>"
