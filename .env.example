# ═══════════════════════════════════════════════════════════════════════════════
# arshanemi-tools-5 — Profit & Loss dashboard
# ═══════════════════════════════════════════════════════════════════════════════

# ── Connected mode ───────────────────────────────────────────────────────────
# "true"  → /api/auth/* and /api/admin/theme proxy to the root admin panel at
#           NEXT_PUBLIC_ADMIN_API_URL; /api/profit-loss/* proxy the caller's own
#           token there for per-user settings + history persistence.
# "false" → local mode: auth reads/writes this app's own Vercel Blob JSON store;
#           the "Save to History" / "My Details" features are unavailable.
NEXT_PUBLIC_IS_CONNECT=true
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3000

# ── Billing ──────────────────────────────────────────────────────────────────
# "Save to History" is metered by the admin panel itself, inside its own
# POST /api/profit-loss/history: 1 coin per 100 parsed rows at the price set
# for the `pl-save-history` feature in Settings → Tools Catalog. To make
# saving free, set that feature's coin cost to 0 there — this flag no longer
# switches the charge off (a flag in the tool app could simply be bypassed).
# Browsing / computing / exporting is always free.
NEXT_PUBLIC_IS_PAID=true

# ── OTP ──────────────────────────────────────────────────────────────────────
# "true" bypasses every OTP step (dev/staging only).
NEXT_PUBLIC_IS_OTP_Verifications_Disable=false

# ── UI flags ─────────────────────────────────────────────────────────────────
# "true" → hides the top navbar (DashboardTopbar) on every page: /profit-loss,
#          /profit-loss/template-settings, /profit-loss/template-access,
#          /profit-loss/debug and /profile. On the dashboard a mobile menu
#          button moves into the "Dashboard" title row so the sidebar drawer
#          stays reachable. Build-time (NEXT_PUBLIC_) — rebuild after changing.
NEXT_PUBLIC_IS_Header_Hide=false
# "true" → shows a floating Profile/Logout shortcuts menu bottom-right on /profile.
NEXT_PUBLIC_SHOW_FLOATING_MENU=false
# The diagnostic screens — "Merged Extracted Common Headers Data" + the
# extraction debugger under the dashboard, and Template Settings' Sheet
# Debugger (/profit-loss/debug). Leave UNSET for the default: shown in
# development (npm run dev), hidden in a production build.
# "true"  → show them in production too (to diagnose a live problem).
# "false" → hide them in development too (to see the production look).
# Build-time (NEXT_PUBLIC_) — rebuild after changing. See lib/debugTools.js.
# NEXT_PUBLIC_SHOW_DEBUG_TOOLS=true

# Namespaces this app's JSON files inside the shared Blob store (local mode).
TOOLS_NAME=barmeto-profit-loss

# ── Auth (JWT) — MUST match the root admin panel's values in connected mode ──
JWT_SECRET="<your-jwt-secret-min-64-chars>"
JWT_REFRESH_SECRET="<your-jwt-refresh-secret>"
NEXT_PUBLIC_SITE_URL="https://profit-loss.barmeto.com/"

# ── CORS — exact origins that call /api/* directly from the browser ──────────
ALLOWED_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# ── Framing — who may embed this app in an <iframe> ─────────────────────────
# The admin panel at NEXT_PUBLIC_ADMIN_API_URL (with and without "www.") is
# always allowed. List any OTHER site that embeds this tool here, as
# comma-separated origins; every site not listed is refused by the browser.
# Build-time (read by next.config.mjs) — rebuild after changing.
FRAME_ANCESTORS=""

# ── SMTP — Gmail App Password (login/reset OTP email) ───────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="<your-sender-email>"
SMTP_PASS="<your-gmail-app-password>"
COMPANY_EMAIL_TO="<your-support-email>"

# ── MSG91 (mobile OTP) — optional; console-logs the OTP if unset ────────────
MSG91_AUTH_KEY="<your-msg91-authkey>"
MSG91_TEMPLATE_ID="<your-msg91-template-id>"
MSG91_OTP_VAR_NAME="VAR1"
MSG91_DEFAULT_COUNTRY_CODE="91"

# ── Vercel Blob — auth store (local mode) + saved-run raw files ─────────────
BLOB_STORE_ID="<your-blob-store-id>"
BLOB_READ_WRITE_TOKEN="<your-blob-read-write-token>"
